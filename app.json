{
  "expo": {
    "name": "H0sS-Money",
    "slug": "hoss-money",
    "version": "1.2.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hossmoney",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#102D39"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.hossmoney.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "H0sS-Money يحتاج الميكروفون لتسجيل المصاريف بالصوت.",
        "NSSpeechRecognitionUsageDescription": "H0sS-Money يستخدم تقنية التعرف على الصوت لتحويل كلامك إلى نص.",
        "NSFaceIDUsageDescription": "H0sS-Money يستخدم Face ID لحماية بياناتك المالية."
      }
    },
    "android": {
      "package": "com.hossmoney.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/splash-icon.png",
        "backgroundColor": "#102D39"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "versionCode": 6,
      "allowBackup": false,
      "icon": "./assets/images/launcher-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "H0sS-Money يستخدم Face ID لحماية بياناتك المالية."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "H0sS-Money يحتاج للوصول لمكتبة الصور لرفع الشعار."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "H0sS-Money يحتاج الميكروفون لتسجيل المصاريف بالصوت."
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#F0B429"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enablePngCrunchInReleaseBuilds": true
          }
        }
      ],
      "@react-native-google-signin/google-signin",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 288,
          "backgroundColor": "#102D39",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#102D39"
          }
        }
      ],
      "./plugins/withPrivateRelease"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": false
    },
    "backgroundColor": "#102D39"
  }
}
