{
  "expo": {
    "name": "H0sS-Money",
    "slug": "hoss-money",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hossmoney",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.hossmoney.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "H0sS-Money \u064a\u062d\u062a\u0627\u062c \u0627\u0644\u0645\u064a\u0643\u0631\u0648\u0641\u0648\u0646 \u0644\u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u0645\u0635\u0627\u0631\u064a\u0641 \u0628\u0627\u0644\u0635\u0648\u062a.",
        "NSSpeechRecognitionUsageDescription": "H0sS-Money \u064a\u0633\u062a\u062e\u062f\u0645 \u062a\u0642\u0646\u064a\u0629 \u0627\u0644\u062a\u0639\u0631\u0641 \u0639\u0644\u0649 \u0627\u0644\u0635\u0648\u062a \u0644\u062a\u062d\u0648\u064a\u0644 \u0643\u0644\u0627\u0645\u0643 \u0625\u0644\u0649 \u0646\u0635.",
        "NSFaceIDUsageDescription": "H0sS-Money \u064a\u0633\u062a\u062e\u062f\u0645 Face ID \u0644\u062d\u0645\u0627\u064a\u0629 \u0628\u064a\u0627\u0646\u0627\u062a\u0643 \u0627\u0644\u0645\u0627\u0644\u064a\u0629."
      }
    },
    "android": {
      "package": "com.hossmoney.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0A0A0A"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "versionCode": 2
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "H0sS-Money \u064a\u0633\u062a\u062e\u062f\u0645 Face ID \u0644\u062d\u0645\u0627\u064a\u0629 \u0628\u064a\u0627\u0646\u0627\u062a\u0643 \u0627\u0644\u0645\u0627\u0644\u064a\u0629."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "H0sS-Money \u064a\u062d\u062a\u0627\u062c \u0644\u0644\u0648\u0635\u0648\u0644 \u0644\u0645\u0643\u062a\u0628\u0629 \u0627\u0644\u0635\u0648\u0631 \u0644\u0631\u0641\u0639 \u0627\u0644\u0634\u0639\u0627\u0631."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "H0sS-Money \u064a\u062d\u062a\u0627\u062c \u0627\u0644\u0645\u064a\u0643\u0631\u0648\u0641\u0648\u0646 \u0644\u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u0645\u0635\u0627\u0631\u064a\u0641 \u0628\u0627\u0644\u0635\u0648\u062a."
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#F0B429"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enablePngCrunchInReleaseBuilds": true
          }
        }
      ],
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": false
    }
  }
}
